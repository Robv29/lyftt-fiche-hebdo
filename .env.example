# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cle-anon
# Clé service-role : utilisée uniquement côté serveur, pour le portail client.
# Ne jamais la préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=cle-service-role

# Sel d'anonymisation des empreintes d'IP (§20). Chaîne aléatoire longue.
IP_HASH_SALT=changez-moi-par-une-chaine-aleatoire-longue

# URL publique de l'application, utilisée pour construire les liens client.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Durée de validité d'un lien de consultation, en jours.
REVIEW_LINK_TTL_DAYS=21

# Secret partagé avec le CRM commercial. Il l'envoie en « Authorization: Bearer »
# sur POST /api/crm/transmission. Sans lui, la route répond 503.
CRM_WEBHOOK_SECRET=changez-moi-par-une-chaine-aleatoire-longue

# Clé de signature du webhook Calendly (« signing key » remise à la création de
# l'abonnement). Laissée vide, la route accepte les appels en journalisant un
# avertissement : le webhook peut être branché avant que la clé ne soit posée.
CALENDLY_WEBHOOK_SECRET=

# Messagerie transactionnelle (Resend). Sans ces deux valeurs, les alertes
# internes sont silencieuses et l'envoi du récapitulatif client, à l'étape 2 de
# « Transmission client », refuse de partir plutôt que de se dater à tort.
RESEND_API_KEY=
MAIL_FROM=LYFTT <bonjour@exemple.fr>
